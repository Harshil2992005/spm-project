# =====================================================================
# PharmaMS environment template.
# Copy to ".env" and fill in your own values. Never commit the real .env.
# =====================================================================

# --- Database --------------------------------------------------------
# Local (docker-compose) default is shown below.
# For cloud, paste your Neon/Render Postgres URL WITH ?sslmode=require
DATABASE_URL=postgresql://pharmacy_user:pharmacy_pass@localhost:5432/pharmacy_db

# --- Security --------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin seed account ---------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@pharmacy.com

# --- E-mail / SMTP (for sending REAL OTP codes) ----------------------
# Leave SMTP_HOST empty to keep demo mode (OTP printed in server log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pharmacy.com
SMTP_TLS=true

# --- OTP behaviour ---------------------------------------------------
# true  -> OTP is returned in the API response (easy demo, no e-mail needed)
# false -> OTP is only e-mailed (requires SMTP settings above)
OTP_EXPIRE_MINUTES=5
OTP_DEBUG=true

# --- Google Sign-In (optional) ---------------------------------------
# Paste your OAuth 2.0 "Web application" client id. Empty = button hidden.
GOOGLE_CLIENT_ID=
GOOGLE_DEFAULT_ROLE_ID=2

# --- Demo data -------------------------------------------------------
SEED_DEMO_DATA=true
